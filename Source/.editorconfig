root = true

[*.cs]
# ── 基本排版與縮排規則 ──
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

# ── 診斷規則 (Diagnostics) ──
# IDE0058: 未使用的運算式值
dotnet_diagnostic.IDE0058.severity = none
# IDE0002: 簡化名稱
dotnet_diagnostic.IDE0002.severity = error
# MA0158: 建議改用 System.Threading.Lock。
# RimWorld 的 Mono mscorlib 雖有此型別，但僅提供 Acquire/Release，
# 缺少 .NET 9 的 EnterScope/Scope 語意，改用後仍是 Monitor 鎖且會觸發 CS9216，故停用。
dotnet_diagnostic.MA0158.severity = none
# MA0141 / MA0142: 建議以模式比對取代 != null / == null。
# UnityEngine.Object 重載了 == 運算子：已 Destroy 的物件 `== null` 為 true，
# 但 `is null` 為 false。本專案大量處理 Texture2D 與圖集，套用此修正會取得
# 已銷毀物件而崩潰，故全專案停用，統一使用 == null / != null。
dotnet_diagnostic.MA0141.severity = none
dotnet_diagnostic.MA0142.severity = none
# MA0181: 不使用強制轉型。
# 本專案中的轉型全數為必要的數值轉換（(long) 防溢位、(double) 取浮點除法、
# (int) 收窄）或反射／DynamicMethod 產生委派後的轉型。此規則建議的
# as / 模式比對對值型別不成立，套用後不是無法編譯就是會移除防溢位語意，
# 故全專案停用。
dotnet_diagnostic.MA0181.severity = none
# S101 / MA0048: 類別命名需符合 PascalCase、檔名需與型別同名。
# Harmony 補丁類別依社群慣例命名為 <型別>_<方法>_Patch，名稱本身即是補丁目標的
# 說明；且這些類別由 Harmony 於執行期透過特性掃描（PatchAll）探索並反射呼叫，
# 分析器看不到任何呼叫端。改名會破壞可讀性與補丁探索，故全專案停用。
# （同一批類別的 MA0182「internal 型別未被實體化」見下方 MA0182 條目。）
dotnet_diagnostic.S101.severity = none
dotnet_diagnostic.MA0048.severity = none
# S3400: 方法僅回傳常值，應改為常數。
# 命中處全為 Harmony prefix（回傳 false 以攔截原方法）與 Prepare/TargetMethod
# 這類必須是「方法」的補丁進入點，無法改為常數，故全專案停用。
dotnet_diagnostic.S3400.severity = none
# MA0032 / MA0040 / MA0042 / MA0045 / MA0134: 建議改用 async／CancellationToken
# ／Task.Delay，並觀察 Task 結果。
# 本模組的非同步進入點全數是 Harmony prefix、Unity 協程與
# StaticConstructorOnStartup 的同步 API，無法改為 async；背景暖機工作刻意採
# fire-and-forget，且各自在委派內以 try/catch 記錄例外，若改為等待就會回到
# 「阻塞啟動」這個本模組要解決的問題本身。Thread.Sleep 亦是刻意用來錯開啟動
# 期磁碟 I/O 尖峰的節流，非同步等待無法取代。故全專案停用。
dotnet_diagnostic.MA0032.severity = none
dotnet_diagnostic.MA0040.severity = none
dotnet_diagnostic.MA0042.severity = none
dotnet_diagnostic.MA0045.severity = none
dotnet_diagnostic.MA0134.severity = none
# MA0217: 建議改用 static lambda。
# 本專案大量使用委派傳遞回呼與快取重置（如 CacheResetter、Startup 等），
# 許多委派為單次執行或設計上維持一般 lambda 可讀性，強制要求 static 屬於純語法偏好，
# 且測試專案中的斷言委派加上 static 亦增加排版噪音，故全專案停用。
dotnet_diagnostic.MA0217.severity = none

# ── 目標框架限制：net472 沒有規則建議的多載 ──
# MA0106: ConcurrentDictionary.GetOrAdd<TArg> 的 factoryArgument 多載
#         自 .NET Core 2.0 起才有，net472 不存在。
dotnet_diagnostic.MA0106.severity = none
# MA0109: net472 無 Span<T> / Memory<T>；為此新增無人呼叫的多載只是死碼。
dotnet_diagnostic.MA0109.severity = none
# MA0001: 命中處是 IndexOf(char)，net472 沒有帶 StringComparison 的 char 多載；
#         char 比對本即 ordinal，語意上也不需要。
dotnet_diagnostic.MA0001.severity = none
# S6610: net472 無 StartsWith(char) / EndsWith(char) 多載。
dotnet_diagnostic.S6610.severity = none

# ── 其餘與本專案設計相牴觸的規則 ──
# MA0025: 命中處是 RedirectHugslibToMainThread 的 HarmonyReversePatch stub，
# 其方法本體會被 Harmony 於執行期整個換掉，throw 只是佔位。下游的 catch 明確
# 捕捉 NotImplementedException 作為「stub 未能綁定」的訊號，改成
# NotSupportedException 會讓該 catch 失效。
dotnet_diagnostic.MA0025.severity = none
# MA0138: XmlChangeDetector.StartScanAsync 為公開互通面，Async 後綴描述的是它
# 啟動了一項非同步工作。改名會破壞相容性，且無法真的改成回傳 Task ——
# 呼叫端是 Mod 建構式這類必須同步回傳的進入點。
dotnet_diagnostic.MA0138.severity = none
# MA0182: internal 型別未被實體化。兩類命中都不成立：
# (1) Harmony 補丁類別由 PatchAll 於執行期以特性掃描探索並反射呼叫，
#     分析器看不到任何呼叫端；
# (2) 唯一的非補丁命中在 NuGet 產生的 Krafs.Publicizer 檔案
#     (IgnoresAccessChecksToAttribute.cs)，非本倉庫原始碼，無法修改。
dotnet_diagnostic.MA0182.severity = none
# S3963: 建議把靜態建構式改為欄位初始化。
# 本專案的五個靜態建構式（Utils、ImageOptCompat、GraphicsSettingsCompat、
# FGLProgressReporter、AdaptiveBakingSkipList）做的是 CacheResetter.Register(...)
# 這個副作用而非欄位初始化。改成欄位初始化會讓型別帶上 beforefieldinit，
# 型別初始化時機不再保證發生於首次成員存取前，語言切換時的快取重置註冊
# 可能根本不執行。
dotnet_diagnostic.S3963.severity = none
# S3267: 建議把迴圈改寫為 LINQ Where。
# 命中處全在啟動熱路徑（Startup.Postfix 的 mod 清單、BakingSkipList 的比對、
# XmlChangeDetector 的掃描）。改用 LINQ 是淨增配置，與本模組的目的相反 ——
# Startup.cs 內既有註解「使用 loop 避免 LINQ 分配」即為此。
dotnet_diagnostic.S3267.severity = none
# S1075: XmlChangeDetector 以硬編的 "/" 組出快取鍵用的相對路徑。
# 這正是刻意的：該鍵必須跨平台穩定，改用 Path.DirectorySeparatorChar 會讓
# Windows 與 Linux 產生不同的雜湊而使快取整批失效。
dotnet_diagnostic.S1075.severity = none

# ── C# 代碼風格偏好 (Code Style Preferences) ──
# using 排序：System 命名空間置頂並按字母排序
dotnet_sort_system_directives_first = true:suggestion
# var 偏好：在初始化型別明確時使用 var
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# ── 花括號與換行樣式偏好 (Formatting Preferences) ──
# 類別、方法、命名空間、屬性、存取器的花括號必須置於新的一行
csharp_new_line_before_open_brace = all
# 控制流語句 (if, catch 等) 的 open brace 置於新的一行
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# ── 命名規範 (Naming Conventions) ──
# 規則 1: 類別、結構、介面、列舉、方法使用 PascalCase
dotnet_naming_rule.types_and_methods_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_and_methods_should_be_pascal_case.symbols = types_and_methods
dotnet_naming_rule.types_and_methods_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.types_and_methods.applicable_kinds = class, struct, interface, enum, method
dotnet_naming_symbols.types_and_methods.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case

# 規則 2: 私有欄位使用底線前綴並配合 camelCase
dotnet_naming_rule.private_fields_should_start_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_should_start_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_start_with_underscore.style = camel_case_with_underscore

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.camel_case_with_underscore.required_prefix = _
dotnet_naming_style.camel_case_with_underscore.capitalization = camel_case

# ── 測試專案專屬規則 ──
[FasterGameLoading.Tests/**.cs]
# MA0181 已於全專案停用（見上方說明）；測試另有其專屬理由：大量以反射取得
# 私有欄位與方法回傳值後轉型，型別不符時應直接拋 InvalidCastException 讓測試
# 失敗，而非以 as 轉成 null 造成誤判。
#
# MA0003（具名引數）、MA0007（尾端逗號）、MA0206（型別宣告的多餘大括號）：
# 純排版偏好。測試方法的引數意義由測試名稱與 Arrange 區塊表達，補上參數名稱
# 只會拉長斷言行而不增加資訊，故僅在測試專案停用。
dotnet_diagnostic.MA0003.severity = none
dotnet_diagnostic.MA0007.severity = none
dotnet_diagnostic.MA0206.severity = none
# MA0002/MA0006/MA0074/MA0076：文化相關的字串比對與格式化。
# 測試中的字串全為測試自行建立的 ASCII 常值，比對的是自己剛寫入的值，
# 不涉及使用者資料或跨語系情境，故僅在測試專案停用。
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.MA0074.severity = none
dotnet_diagnostic.MA0076.severity = none
# CA1861: 建議使用 static readonly 欄位取代常數陣列引數。
# 測試專案中直接在呼叫處寫入字面常數陣列能提供最佳的上下文與可讀性，
# 在測試執行中避免微量陣列配置並無效能意義，反而增加宣告跳轉負擔，故於測試專案停用。
dotnet_diagnostic.CA1861.severity = none
